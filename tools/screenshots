"""screenshots - make the README's screenshots from the sample vault.

    tools/screenshots [out_dir]          # default: docs/screenshots

Copies the sample vault into a throwaway git repository (tools/demo-vault, with a bare remote), starts Niwa on it in the
background (NIWA_AUTH=open, 127.0.0.1, a free web port, TZ=UTC), takes the shots with Playwright's Chromium, and stops
Niwa: the desk, a note, the queue and the stream at 1280x800 in light and dark, and the desk and a note at phone width
(390x844). Then it starts Niwa again with the public garden on (NIWA_PUBLIC_PORT) and takes the garden's home from it,
as visitors see it, at both sizes. PNGs are written as <out_dir>/niwa-<what>-<light|dark>.png and squeezed
to a small palette when they are over 200 KB. Nothing but the sample vault is ever shown. Niwa's gemini and gopher listeners need ports 1965 and 7070
free (the web pages work without them).

Needs Playwright for Python with its Chromium (`pip install playwright pillow && playwright install chromium`, in any
virtual environment) and the packages Niwa itself needs (markdown, pyyaml); run it with that environment's python3.
Standard library, Playwright and Pillow only.
"""
import os
import shutil
import signal
import socket
import subprocess
import sys
import tempfile
import time
import urllib.request

from playwright.sync_api import sync_playwright

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = sys.argv[1] if len(sys.argv) > 1 else os.path.join(ROOT, "docs", "screenshots")
LIMIT = 200 * 1024
DESKTOP = {"width": 1280, "height": 800}
PHONE = {"width": 390, "height": 844}
THEMES = {"light": ("day", "light"), "dark": ("night", "dark")}      # name -> (the theme cookie, browser colour scheme)
SHOTS = [                      # (what, path, viewport, themes)
    ("desk", "/", DESKTOP, ("light", "dark")),
    ("note", "/n/Notes/Chochin%20folding", DESKTOP, ("light", "dark")),
    ("queue", "/queue", DESKTOP, ("light", "dark")),
    ("stream", "/stream", DESKTOP, ("light", "dark")),
    ("desk-phone", "/", PHONE, ("light",)),
    ("note-phone", "/n/Notes/Chochin%20folding", PHONE, ("light",)),
]
# from the public garden, without the owner's Visitor View banner; a run of its own, so the desk shows the garden off
PUBLIC_SHOTS = [
    ("garden", "/", DESKTOP, ("light", "dark")),
    ("garden-phone", "/", PHONE, ("light", "dark")),
]


def squeeze(path):
    if os.path.getsize(path) <= LIMIT:
        return
    from PIL import Image
    im = Image.open(path).convert("RGB").quantize(colors=128, method=Image.Quantize.MEDIANCUT, dither=Image.Dither.NONE)
    im.save(path, optimize=True)


def free_port():
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def start(work, env, port):
    """Start Niwa in the background and wait until it is ready; returns the process."""
    server = subprocess.Popen([sys.executable, os.path.join(ROOT, "app", "niwa.py")], env=env, start_new_session=True,
                              stdout=open(os.path.join(work, "log"), "a"), stderr=subprocess.STDOUT)
    for _ in range(120):
        try:
            if b'"ready": true' in urllib.request.urlopen("http://127.0.0.1:%d/api/status" % port, timeout=2).read():
                return server
        except OSError:
            pass
        time.sleep(0.5)
    stop(server)
    sys.exit("screenshots: Niwa did not start; see %s/log" % work)


def stop(server):
    try:
        os.killpg(server.pid, signal.SIGTERM)
        server.wait(timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        pass


def shoot(browser, base, shots):
    for what, path, viewport, themes in shots:
        for theme in themes:
            cookie, scheme = THEMES[theme]
            kw = dict(viewport=viewport, device_scale_factor=1, color_scheme=scheme, service_workers="block")
            if viewport is PHONE:
                kw.update(is_mobile=True, has_touch=True, device_scale_factor=2)
            ctx = browser.new_context(**kw)
            ctx.add_cookies([{"name": "theme", "value": cookie, "url": base}])
            # no preference sync: an earlier shot's theme, saved through /api/prefs, would win over the cookie
            ctx.route("**/api/prefs", lambda route: route.abort())
            page = ctx.new_page()
            page.goto(base + path, wait_until="load")
            page.wait_for_timeout(700)
            stem = what.replace("-phone", "")
            fname = "niwa-%s%s-%s.png" % (stem, "-phone" if what.endswith("-phone") else "", theme)
            target = os.path.join(OUT, fname)
            page.screenshot(path=target)
            ctx.close()
            squeeze(target)
            print("%-30s %6.0f KB" % (fname, os.path.getsize(target) / 1024))


def main():
    port = free_port()
    work = tempfile.mkdtemp(prefix="niwa-shots-", dir=os.environ.get("SHOTS_TMP", "/var/tmp"))
    server = None
    try:
        vault = os.path.join(work, "vault")
        subprocess.run([os.path.join(ROOT, "tools", "demo-vault"), vault, "--bare"], check=True, capture_output=True)
        env = dict(os.environ, NIWA_REPO_URL="file://%s.git" % vault, NIWA_REPO_DIR=os.path.join(work, "repo"),
                   NIWA_REPO_SUBDIR="personal", NIWA_DB=os.path.join(work, "n.sqlite3"), NIWA_AUTH="open",
                   NIWA_BIND="127.0.0.1", NIWA_PORT=str(port), NIWA_HOST="localhost", TZ="UTC", PYTHONDONTWRITEBYTECODE="1",
                   NIWA_ARCHIVE="none")       # the sample's links never go to archive.org
        for k in [k for k in env if k.startswith(("NIWA_KONBINI", "NIWA_KURA", "NIWA_HISTER", "MACHIYA_", "NIWA_PUBLIC",
                                                  "NIWA_GARDEN_URL"))]:
            del env[k]
        os.makedirs(OUT, exist_ok=True)
        with sync_playwright() as p:
            browser = p.chromium.launch()
            server = start(work, env, port)
            shoot(browser, "http://127.0.0.1:%d" % port, SHOTS)
            stop(server)
            public = free_port()
            env.update(NIWA_PUBLIC_PORT=str(public), NIWA_GARDEN_URL="https://garden.example.com")
            server = start(work, env, port)
            shoot(browser, "http://127.0.0.1:%d" % public, PUBLIC_SHOTS)
            browser.close()
    finally:
        if server:
            stop(server)
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    main()
